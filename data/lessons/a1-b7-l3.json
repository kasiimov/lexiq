    "points": [
      {
        "text": "Noto'g'ri fe'llar -ed olmaydi — ularning o'tgan zamon shakli butunlay boshqacha bo'ladi. Qoida yo'q, faqat yodlash. Yaxshi xabar: kundalik nutqda 20 tasi yetadi.",
        "examples": [
          { "en": "I go → I went", "uz": "Men boraman → Men bordim" },
          { "en": "She has → She had", "uz": "Uning bor → Uning bor edi" }
