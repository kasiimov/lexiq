      },
      {
        "text": "Ba'zi fe'llar butunlay o'zgaradi: go → went, see → saw, take → took. Bularni bog'lash mumkin emas, shunchaki yodlanadi.",
        "examples": [
          { "en": "We saw a good film.", "uz": "Biz yaxshi film ko'rdik." },
          { "en": "He took a taxi.", "uz": "U taksi oldi." }
        ]
      },
      {
        "text": "Ba'zilari faqat unlisini almashtiradi — bu guruhni yodlash osonroq: come → came, give → gave, sit → sat, drink → drank.",
        "examples": [
          { "en": "They came at seven.", "uz": "Ular soat yettida kelishdi." },
          { "en": "I drank tea.", "uz": "Men choy ichdim." }
        ]
      },
      {
        "text": "Bir nechtasi umuman o'zgarmaydi: put → put, cut → cut, read → read. Read yozilishda bir xil qoladi, lekin talaffuzi o'zgaradi: /riːd/ → /red/.",
        "examples": [
          { "en": "I read a book last night. /red/", "uz": "Kecha kitob o'qidim." },
          { "en": "He put the keys on the table.", "uz": "U kalitlarni stolga qo'ydi." }
        ]
      }
    ],
