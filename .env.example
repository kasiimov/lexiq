# Скопируйте в .env и подставьте свои ключи (.env в git не попадает).
# На проде те же переменные задаются в Netlify:
# Site configuration → Environment variables.

# Основной провайдер — лучше всех держит узбекский.
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Резерв: подхватывается, если Gemini не задан или вернул 429/5xx.
# Ключ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Последняя ступень цепочки, на бесплатной модели.
# Пустую переменную не оставляйте: провайдер отбирается по факту наличия ключа,
# а не по его работоспособности, и мёртвый ключ добавит лишний неудачный поход
# по сети на каждый запрос.
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
