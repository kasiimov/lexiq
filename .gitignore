# Netlify local state
.netlify

# Секреты для локальной разработки (netlify dev читает этот файл автоматически)
.env
.env.*
!.env.example

# Исходники макета лендинга (React + Tailwind). Сайт собран из них вручную
# в index.html и assets/css/site.css. В репозиторий не кладём: publish = "."
# в netlify.toml, и всё отсюда уехало бы на прод как есть.
congix-landing

# Учебники-исходники. Две причины держать их снаружи: это чужой материал под
# копирайтом, а репозиторий публичный; и publish = "." в netlify.toml — всё,
# что лежит в корне, уезжает на прод и становится доступно по прямой ссылке.
# В проект попадают только производные данные: словарь, программа и уроки.
cours books/
course books/

# Тесты и ключи ответов к ним. Даже если папку положат не в «cours books»,
# ответы не должны уехать в публичный репозиторий и на прод.
tests/
tests answer/
test answers/

# macOS
.DS_Store

# Editor
.vscode

# Claude Code / agent skills
.agents
.claude
skills-lock.json

# Local env for netlify dev (ключи ИИ)
.env

